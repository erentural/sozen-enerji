generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  phone            String?
  password         String        
  role             String        @default("USER")
  resetToken       String?       // YENİ: Şifre sıfırlama linki için özel kod
  resetTokenExpiry DateTime?     // YENİ: Kodun geçerlilik süresi (Örn: 1 saat)
  projects         Project[]
  appointments     Appointment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float?   
  imageUrl    String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String   
  description String?
  progress    Int      @default(0) 
  isCompleted Boolean  @default(false)
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?  @db.Text
}

model Appointment {
  id          String            @id @default(cuid())
  date        DateTime          
  subject     String            
  status      AppointmentStatus @default(PENDING)
  customerId  String
  customer    User              @relation(fields: [customerId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completedAt DateTime?         // YENİ: Randevunun tamamlandığı tarihi tutacak opsiyonel alan
}

model QuoteRequest {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String
  service    String   // Örn: Çatı GES Kurulumu, Fabrika vb.
  bill       Float?   // Hesaplayıcıdan gelen fatura tutarı
  region     String?  // Bölge
  city       String?  // Şehir
  panelCount Int?     // Gereken panel adedi
  roiYears   String?  // Amorti süresi
  status     String   @default("YENI") // YENI, GORUSULDU, KAPANDI
  priceOffer Float?
  createdAt  DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String  
  subject   String?  // Konu
  message   String   // Mesaj içeriği
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// YENİ EKLENEN: Sistem Ayarları Modeli
model Settings {
  id                 Int      @id @default(1)
  
  // Kurumsal Bilgiler
  companyName        String?
  supportEmail       String?
  phone              String?
  address            String?

  // Bildirim Tercihleri
  emailOnAppointment Boolean  @default(true)
  emailOnMessage     Boolean  @default(true)
  emailOnQuote       Boolean  @default(true)
  smsAlerts          Boolean  @default(false)

  updatedAt          DateTime @updatedAt
}

model SystemSettings {
  id           String   @id @default("global")
  companyName  String?  @default("Sözen Enerji")
  supportEmail String?  @default("destek@sozen-enerji.com")
  phone        String?  
  address      String?
  smtpHost     String?  @default("smtp.gmail.com")
  smtpPort     Int?     @default(465)
  smtpUser     String?  
  smtpPass     String?
  workHourStart    String?  @default("08:30")
  workHourEnd      String?  @default("18:30")
  allowWeekend     Boolean  @default(false) // false = Sadece hafta içi
  taxNumber        String?  
  mersisNumber     String?  
  pdfFooterText    String?  @default("Bu belge Sözen Enerji CRM sistemi tarafından otomatik olarak üretilmiştir.")
  logoUrl          String?  // İleride rapora eklenebilecek şirket logosu URL'si
  updatedAt        DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String   // Yazının başlığı
  slug        String   @unique // URL dostu başlık (orn: gunes-enerjisi-tesvikleri)
  summary     String?  // Kısa özet
  content     String   @db.Text // Yazının tam içeriği (HTML formatında tutabiliriz)
  imageUrl    String?  // Kapak fotoğrafı
  published   Boolean  @default(true) // Yayında mı, taslak mı?
  viewCount   Int      @default(0) // Okunma sayısı
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}