generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String?       // YENİ: Telefon numarasını ekledik (opsiyonel olması için sonuna ? koyduk)
  password      String        
  role          Role          @default(USER)
  projects      Project[]
  appointments  Appointment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float?   
  imageUrl    String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String   
  description String?
  progress    Int      @default(0) 
  isCompleted Boolean  @default(false)
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl        String?  @db.Text
}

model Appointment {
  id          String            @id @default(cuid())
  date        DateTime          
  subject     String            
  status      AppointmentStatus @default(PENDING)
  customerId  String
  customer    User              @relation(fields: [customerId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model QuoteRequest {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String
  service    String   // Örn: Çatı GES Kurulumu, Fabrika vb.
  bill       Float?   // Hesaplayıcıdan gelen fatura tutarı
  region     String?  // Bölge
  city       String?  // Şehir
  panelCount Int?     // Gereken panel adedi
  roiYears   String?  // Amorti süresi
  status     String   @default("YENI") // YENI, GORUSULDU, KAPANDI
  priceOffer Float?
  createdAt  DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String  
  subject   String?  // Konu (Örn: Öneri, Şikayet, Bilgi Talebi)
  message   String   // Mesaj içeriği
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
}